{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "T=\"${CLAUDE_PROJECT_DIR:-.}/scripts/enforce-token-reduce-first.py\"; timeout 5 uv run \"$T\" >/dev/null; exit 0"
          },
          {
            "type": "command",
            "command": "[ -x ~/.claude/hooks/rtk-rewrite.sh ] && ~/.claude/hooks/rtk-rewrite.sh || exit 0"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "T=\"${CLAUDE_PROJECT_DIR:-.}/scripts/enforce-token-reduce-first.py\"; timeout 5 uv run \"$T\" >/dev/null; exit 0"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "T=\"${CLAUDE_PROJECT_DIR:-.}/scripts/enforce-token-reduce-first.py\"; timeout 5 uv run \"$T\" >/dev/null; exit 0"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "T=\"${CLAUDE_PROJECT_DIR:-.}/scripts/enforce-token-reduce-first.py\"; timeout 5 uv run \"$T\" >/dev/null; exit 0"
          }
        ]
      }
    ]
  }
}
